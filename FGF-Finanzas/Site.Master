<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="FGF_Finanzas.Site" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>FGF Finanzas</title>

    <link href="Content/Estilos.css" rel="stylesheet" />
    <script src='<%= ResolveUrl("~/Scripts/scripts.js?v=" + DateTime.Now.Ticks) %>' type="text/javascript"></script>

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <link href="Content/Estilos.css" rel="stylesheet" />

</head>
<body>
    <form id="form1" runat="server">
        <nav class="custom-nav">
            <div class="nav-container">
                <ul class="nav-menu">
                    <li><a href="/Default.aspx">FGF Finanzas</a></li>
                    <li><a href="/Login.aspx">Iniciar Sesión</a></li>
                    <li><a href="/Registrarse.aspx">Registrarse</a></li>
                    <%if (FGF_Finanzas.Capas.Servicios.SessionManager.Instancia != null)
                        { %>
                    <li>
                        <asp:Button runat="server" OnClick="LogoutBtn_Click" ID="LogoutBtn" Text="Cerrar Sesión" />
                    </li>
                    <% } %>
                </ul>
                <!-- Icono para móvil -->
                <div class="nav-toggle" id="mobile-menu">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </div>
        </nav>
        <div class="container body-content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
            <hr />

        </div>
        <footer>
            <p>&copy; <%: DateTime.Now.Year %> - FGF Finanzas</p>
        </footer>
    </form>
</body>
</html>
