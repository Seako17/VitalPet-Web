<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="FGF_Finanzas.Site" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>VitalPet</title>

    <link href="Content/Estilos.css" rel="stylesheet" />
    <script src='<%= ResolveUrl("~/Scripts/scripts.js?v=" + DateTime.Now.Ticks) %>' type="text/javascript"></script>

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <asp:ScriptManager ID="smPrincipal" runat="server" EnablePartialRendering="true" />

        <header>
            <nav class="navbar">

                <div class="navbar-logo">
                    <img src="Content/logoVitalPet.png" class="logoVitalPet" alt="Logo" />
                    <a href="/Default.aspx">VitalPet</a>
                </div>

                <button type="button" class="nav-toggle" id="mobile-menu" aria-label="Abrir menú" aria-expanded="false" aria-controls="nav-menu">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
                <ul class="navbar-menu" id="nav-menu">
                    <li><asp:HyperLink runat="server" ID="lnkMarketplace" NavigateUrl="~/Marketplace.aspx" Text="Tienda" /></li>

                    <li>
                        <asp:HyperLink runat="server" ID="lnkLogin" NavigateUrl="/Login.aspx" Text="Iniciar sesión" /></li>
                    <li>
                        <asp:HyperLink runat="server" ID="lnkRegistro" NavigateUrl="/Registrarse.aspx" Text="Registrarse" /></li>
                    <li id="Admin" runat="server">
                        <asp:HyperLink runat="server" ID="lnkAdmin" NavigateUrl="~/Administracion.aspx" Text="Administrador" /></li>
                    <li id="Cliente" runat="server">
                        <asp:HyperLink runat="server" ID="lnkMascotas" NavigateUrl="RegistrarMascotas.aspx" Text="Mis mascotas" /></li>

                    <li id="Atencion" runat="server">
                        <asp:HyperLink runat="server" ID="lnkAtenderConsultas" NavigateUrl="Atenciones.aspx" Text="Atender consultas" /></li>
                    <li id="Informes" runat="server">
                        <asp:HyperLink runat="server" ID="lnkInformes" NavigateUrl="~/Informe-Consultas.aspx" Text="Informes" /></li>

                    <li id="dropdownList" runat="server" class="dropdown">
                        <a href="javascript:void(0);" class="dropdown-btn" onclick="toggleDropdown(event)"><asp:Label ID="lblMenuConsultas" runat="server" Text="Consultas" /></a>

                        <ul class="dropdown-menu" id="consultas-menu">
                            <li>
                                <asp:HyperLink ID="lnkNuevaConsulta" runat="server" NavigateUrl="Consulta.aspx" Text="Nueva consulta" />
                            </li>
                            <li>
                                <asp:HyperLink ID="lnkMisConsultas" runat="server" NavigateUrl="MisConsultas.aspx" Text="Mis consultas" />
                            </li>
                        </ul>
                    </li>

                    <li id="itemCambiarPass" runat="server">
                        <asp:HyperLink runat="server" ID="lnkCambiarPass" NavigateUrl="~/Cambiar-Contrase%C3%B1a.aspx" Text="Cambiar Contraseña" /></li>
                    <li id="itemCerrarSesion" runat="server">
                        <asp:Button runat="server" OnClick="LogoutBtn_Click" ID="LogoutBtn" Text="Cerrar Sesión" class="btn-logout" CausesValidation="false" />
                    </li>
                    <li class="idioma-menu-css">
                        <details class="idioma-dropdown" id="detailsIdioma">
                            <summary class="idioma-boton-actual">
                                <img src="Content/mundo.png" alt="Idioma" class="icono-mundo" />
                                <asp:Label runat="server" ID="lblIdiomaSeleccionado" Text="Idioma" />
                                <span class="flechita">&#9662;</span>
                            </summary>

                            <ul class="idioma-sublista">
                                <asp:Repeater runat="server" ID="rptIdiomas" OnItemCommand="rptIdiomas_ItemCommand">
                                    <ItemTemplate>
                                        <li>
                                            <asp:LinkButton runat="server"
                                                CommandName="CambiarIdioma"
                                                CommandArgument='<%# Eval("Codigo") %>'
                                                CausesValidation="false">
                            <%# Eval("Nombre") %>
                                            </asp:LinkButton>
                                        </li>
                                    </ItemTemplate>
                                </asp:Repeater>
                            </ul>
                        </details>
                    </li>
                </ul>

            </nav>
        </header>

        <div class="container body-content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </div>

        <footer>
            <hr />
            <br />
            <p>&copy; <%: DateTime.Now.Year %> - Vital Pet</p>
        </footer>
    </form>
</body>
</html>
