<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="DBConnection" connectionString="Data Source=.;Initial Catalog=FGF-BDD;Integrated Security=True;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8.1" />
    <httpRuntime targetFramework="4.8.1" />
    <authentication mode="None" />
    <customErrors mode="RemoteOnly" />
    <webServices><protocols><clear /><add name="HttpSoap" /><add name="Documentation" /></protocols></webServices>
  </system.web>
</configuration>
